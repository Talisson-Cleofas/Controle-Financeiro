{
  "name": "controle-financeiro-mongodb",
  "version": "2.0.0",
  "private": true,
  "description": "Projeto completo com frontend PWA, backend Node.js/Express e MongoDB.",
  "scripts": {
    "postinstall": "npm ci --prefix backend",
    "start": "node backend/src/homologation.js",
    "backend:install": "cd backend && npm install",
    "backend:dev": "cd backend && npm run dev",
    "backend:start": "cd backend && npm start",
    "mobile:add:android": "npx cap add android",
    "mobile:add:ios": "npx cap add ios",
    "mobile:copy": "npx cap copy",
    "mobile:open:android": "npx cap open android",
    "mobile:open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.0",
    "gsap": "^3.13.0",
    "ogl": "^1.0.11"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@capacitor/android": "^6.2.0",
    "@capacitor/ios": "^6.2.0"
  }
}
