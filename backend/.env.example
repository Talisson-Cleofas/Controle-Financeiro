# ==============================
# CONTROLE FINANCEIRO API - .ENV
# ==============================
# Copie este arquivo para .env dentro da pasta backend:
# cp .env.example .env

# Porta local da API
PORT=3000

# URL do frontend autorizado pelo CORS.
# Desenvolvimento local:
CLIENT_URL=http://localhost:5500
# Produção exemplo, depois de publicar o frontend:
# CLIENT_URL=https://seu-app.netlify.app

# MongoDB Atlas
# IMPORTANTE: nunca coloque esta string no frontend.
# Modelo que funcionou nos testes:
# mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/controle_financeiro?retryWrites=true&w=majority&appName=Cluster0
MONGO_URI=mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/controle_financeiro?retryWrites=true&w=majority&appName=Cluster0

# Chave secreta forte para JWT.
# Gere uma chave no Mac com: openssl rand -base64 64
JWT_SECRET=COLE_AQUI_UMA_CHAVE_FORTE_GERADA_NO_TERMINAL

# Tempo de validade do login
JWT_EXPIRES_IN=7d

# Ambiente local
NODE_ENV=development
